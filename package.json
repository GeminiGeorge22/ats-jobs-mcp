{
  "name": "ats-jobs-mcp",
  "version": "0.2.0",
  "description": "Stdio MCP server for new job postings from Ashby, Greenhouse, Lever and SmartRecruiters via Apify's hosted MCP gateway",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ats-jobs-mcp": "src/server.js"
  },
  "main": "src/proxy.js",
  "files": [
    "src",
    "tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/env-guard.test.js test/proxy.test.js",
    "build:tools": "node scripts/build-tools.mjs",
    "check:tools": "node scripts/build-tools.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeminiGeorge22/ats-jobs-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apify"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "mcpProxy": {
    "actors": [
      "publicrecords/ashby-jobs-scraper",
      "publicrecords/greenhouse-jobs-scraper",
      "publicrecords/lever-jobs-scraper",
      "publicrecords/smartrecruiters-jobs-scraper"
    ]
  }
}
